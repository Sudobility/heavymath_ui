{
  "name": "@sudobility/heavymath_ui",
  "version": "0.0.57",
  "description": "Shared UI components, hooks, and utilities for Heavymath prediction market apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run format:check"
  },
  "peerDependencies": {
    "@sudobility/components": "^5.3.39",
    "@sudobility/design": "^1.1.63",
    "@sudobility/di": "^1.5.76",
    "@sudobility/heavymath_contracts": "^0.1.79",
    "@sudobility/heavymath_indexer_client": "^0.0.66",
    "@sudobility/heavymath_lib": "^0.0.96",
    "@sudobility/heavymath_types": "^0.0.38",
    "@sudobility/types": "^1.9.75",
    "@sudobility/web3-components": "^2.0.16",
    "@heroicons/react": ">=2.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "i18next": ">=25.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=16.0.0",
    "react-icons": ">=5.0.0",
    "react-router-dom": ">=7.0.0",
    "recharts": ">=3.0.0",
    "viem": ">=2.0.0",
    "wagmi": ">=2.0.0"
  },
  "devDependencies": {
    "@heroicons/react": "~2.2.0",
    "@sudobility/components": "^5.3.39",
    "@sudobility/design": "^1.1.63",
    "@sudobility/di": "^1.5.76",
    "@sudobility/heavymath_contracts": "^0.1.79",
    "@sudobility/heavymath_indexer_client": "^0.0.66",
    "@sudobility/heavymath_lib": "^0.0.96",
    "@sudobility/heavymath_types": "^0.0.38",
    "@sudobility/types": "^1.9.75",
    "@sudobility/web3-components": "^2.0.16",
    "@tanstack/react-query": "~5.104.5",
    "@types/dompurify": "~3.2.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "i18next": "~25.10.10",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~16.6.6",
    "react-icons": "~5.7.0",
    "react-router-dom": "~7.18.4",
    "recharts": "~3.10.1",
    "typescript": "~5.9.3",
    "viem": "~2.57.10",
    "vitest": "~4.1.12",
    "wagmi": "~2.19.5"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/heavymath_ui.git"
  },
  "dependencies": {
    "dompurify": "~3.4.17",
    "marked": "~18.1.1",
    "react-markdown": "~10.1.0",
    "rehype-sanitize": "~6.0.0"
  }
}
